apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: aws-load-balancer-service-account
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "-6"
spec:
  project: default
  source:
    repoURL: git@github.com:kramarov666/miracle6-k8s.git
    targetRevision: HEAD
    path: aws-load-balancer-service-account
    helm:
      parameters:
        - name: loadBalancerRoleArn
          value: "${alb_role_arn}"
  destination:
    server: https://kubernetes.default.svc
    namespace: kube-system